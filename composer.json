{
    "name": "neiderruiz/translate-projects-laravel",
    "description": "Translate your Laravel project with Translate Projects",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Neiderruiz\\TranslateProjectsLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neiderruiz\\TranslateProjectsLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Neiderruiz\\TranslateProjectsLaravel\\TranslateProjectsLaravelServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Neider Ruiz",
            "email": "neiderbtc@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5",
        "symfony/finder": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
